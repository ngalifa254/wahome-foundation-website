{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|avif|svg|mp4|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      { "regex": "^/boston/?$", "destination": "/miles-for-minds", "type": 301 },
      { "regex": "^/donations/(boston|boston-marathon-2)/?$", "destination": "/miles-for-minds", "type": 301 },
      { "regex": "^/about/$", "destination": "/about", "type": 301 },
      { "regex": "^/wells-of-hope/$", "destination": "/wells-of-hope", "type": 301 },
      { "regex": "^/thomas-dk-wahome-scholarship/$", "destination": "/thomas-dk-wahome-scholarship", "type": 301 },
      { "regex": "^/prize-giving/$", "destination": "/prize-giving", "type": 301 },
      { "regex": "^/roaming-reads/?$", "destination": "/", "type": 301 },
      { "regex": "^/(service|donations)/thomas-d-k-wahome-scholarship/?$", "destination": "/thomas-dk-wahome-scholarship", "type": 301 },
      { "regex": "^/(service|donations)/prize-giving/?$", "destination": "/prize-giving", "type": 301 },
      { "regex": "^/service/wells-of-hope/?$", "destination": "/wells-of-hope", "type": 301 },
      { "regex": "^/donations/sponsor-for-trusted-and-pure-water-for-peoples/?$", "destination": "/wells-of-hope", "type": 301 },
      { "regex": "^/(service|donations)/roaming-reads/?$", "destination": "/", "type": 301 },
      { "regex": "^/our-initiatives/?$", "destination": "/", "type": 301 },
      { "regex": "^/contact/?$", "destination": "/", "type": 301 },
      { "regex": "^/donor-dashboard/?$", "destination": "/", "type": 301 },
      { "regex": "^/donation-(confirmation(-2)?|failed(-2)?|list|history|form)/?$", "destination": "/", "type": 301 },
      { "regex": "^/donations(?:/.*)?/?$", "destination": "/", "type": 301 },
      { "regex": "^/service(?:/.*)?/?$", "destination": "/", "type": 301 },
      { "regex": "^/cause(?:/.*)?/?$", "destination": "/", "type": 301 },
      { "regex": "^/cause_category(?:/.*)?/?$", "destination": "/", "type": 301 },
      { "regex": "^/team(?:/.*)?/?$", "destination": "/about", "type": 301 },
      { "regex": "^/testimonial(?:/.*)?/?$", "destination": "/mentorship", "type": 301 },
      { "regex": "^/portfolio(?:/.*)?/?$", "destination": "/about", "type": 301 },
      { "regex": "^/portfolio_category(?:/.*)?/?$", "destination": "/about", "type": 301 },
      { "regex": "^/tag(?:/.*)?/?$", "destination": "/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "africa-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
